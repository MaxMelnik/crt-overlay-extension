{
  "manifest_version": 3,
  "name": "CRT Overlay",
  "version": "1.1.0",
  "author": "Maks Melnyk",
  "homepage_url": "https://github.com/MaxMelnik/crt-overlay-extension",
  "description": "Adds a CRT screen effect to websites",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "CRT Overlay",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon970.png",
      "32": "icons/icon970.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
