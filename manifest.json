
{
  "manifest_version": 3,
  "name": "CRT Overlay",
  "version": "1.0.0",
  "author": "Maks Melnyk",
  "homepage_url": "https://github.com/MaxMelnik/crt-overlay-extension",
  "description": "Adds a CRT screen effect to websites",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
